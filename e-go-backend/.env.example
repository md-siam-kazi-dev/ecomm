# ─── App ──────────────────────────────────────────────────────────────
APP_ENV=development
# Public platform name, used on the approval letter and notifications.
APP_NAME=ShopKart
APP_PORT=8080
APP_READ_TIMEOUT=15s
APP_WRITE_TIMEOUT=15s
APP_IDLE_TIMEOUT=60s
APP_SHUTDOWN_TIMEOUT=10s
APP_MAX_REQUEST_BODY_BYTES=1048576

# ─── Database (PostgreSQL / Neon) — REQUIRED ─────────────────────────
# Example (Neon requires sslmode=require):
#   postgres://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m
DB_CONNECT_TIMEOUT=10s

# ─── Redis (optional in development) ─────────────────────────────────
#   redis://localhost:6379/0
REDIS_URL=
REDIS_POOL_SIZE=10
REDIS_DIAL_TIMEOUT=5s
REDIS_READ_TIMEOUT=3s
REDIS_WRITE_TIMEOUT=3s

# ─── JWT — REQUIRED ──────────────────────────────────────────────────
# Generate each secret with: openssl rand -base64 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=e-go-backend
JWT_AUDIENCE=e-go-api
JWT_ACCESS_TTL=15m
# Refresh-token lifetime. 168h = 7 days.
JWT_REFRESH_TTL=168h

# ─── CORS ────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000
CORS_ALLOWED_METHODS=GET,POST,PATCH,PUT,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Authorization,Content-Type,Idempotency-Key,X-Request-Id

# ─── Auth / cookies ──────────────────────────────────────────────────
# Browser origin of the frontend. Also merged into the CORS allow-list and
# used for verification / password-reset email links.
FRONTEND_URL=http://localhost:3000
# Set true when served over HTTPS (production). Keep false for local HTTP.
COOKIE_SECURE=false
# Optional parent domain for auth cookies, e.g. .example.com
COOKIE_DOMAIN=

# ─── Image hosting (imgbb.com) ───────────────────────────────────────
# API key for profile-picture uploads. Get one at https://api.imgbb.com/
IMGBB_API_KEY=

# ─── Object storage (S3 / Cloudflare R2) ─────────────────────────────
STORAGE_ENDPOINT=
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# ─── Payments (Stripe) ───────────────────────────────────────────────
# PAYMENT_PROVIDER=stripe enables Stripe Checkout. Set the sandbox secret key.
# Webhooks are verified with PAYMENT_WEBHOOK_SECRET (from the Stripe endpoint
# or `stripe listen`). Leave empty to disable online payment.
PAYMENT_PROVIDER=
PAYMENT_PROVIDER_KEY=
PAYMENT_WEBHOOK_SECRET=
# Default order currency (ISO-4217, lowercase).
PAYMENT_CURRENCY=usd

# ─── Application fee (vendor onboarding) ─────────────────────────────
# When enabled, a store activates only after a verified application-fee
# payment. Disabled by default so stores can activate after approval while no
# payment provider is integrated.
APPLICATION_FEE_ENABLED=false
# Decimal string (never a float). Currency is ISO-4217.
APPLICATION_FEE_AMOUNT=1500.00
APPLICATION_FEE_CURRENCY=BDT

# ─── Order pricing ───────────────────────────────────────────────────
# Flat shipping rates; orders at or above the threshold ship free. Tax is 0.
ORDER_STANDARD_SHIPPING=5.99
ORDER_EXPRESS_SHIPPING=12.99
ORDER_FREE_SHIPPING_THRESHOLD=75

# ─── Logging ─────────────────────────────────────────────────────────
LOG_LEVEL=info
